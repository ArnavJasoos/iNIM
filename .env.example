# =============================================================================
# iNIM Environment Variables
# Copy to .env and customize for your deployment
# =============================================================================

# --- Model Configuration ---
# HuggingFace repo ID, or local path to model directory
# The user will be prompted for this if not set
INIM_MODEL=

# Override automatic profile selection (use profile ID or description)
# INIM_MODEL_PROFILE=ovms-int4-arc-hq-cb

# Model name returned by /v1/models endpoint (defaults to manifest model_id)
# INIM_SERVED_MODEL_NAME=

# Path to manifest directory or specific YAML file
# INIM_MANIFEST_PATH=/opt/inim/etc/manifests

# --- Server ---
INIM_SERVER_PORT=8000
# INIM_HEALTH_PORT=

# --- Paths ---
INIM_CACHE_PATH=/opt/inim/.cache

# --- Operational ---
INIM_LOG_LEVEL=info
INIM_OFFLINE=0
INIM_READY_TIMEOUT=300

# --- TLS (optional) ---
# INIM_TLS_CERT_PATH=/path/to/cert.pem
# INIM_TLS_KEY_PATH=/path/to/key.pem

# --- CORS ---
INIM_ALLOWED_ORIGINS=*

# --- HuggingFace ---
# Required for gated models (e.g., Llama)
# The user will be prompted for this if not set
HF_TOKEN=
# HF_ENDPOINT=https://huggingface.co

# --- OVMS ---
OVMS_LOG_LEVEL=INFO

# --- GGUF Tokenizer (optional) ---
# Override tokenizer source for GGUF models
# INIM_TOKENIZER_REPO=meta-llama/Llama-3.2-3B-Instruct
